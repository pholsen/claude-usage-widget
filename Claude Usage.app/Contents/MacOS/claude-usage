#!/bin/bash
# Starts the widget that sits next to this app with a Python that has Tkinter.
# Apps opened from Finder get a minimal PATH, so look in the usual install places.
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
SCRIPT="$DIR/claude_usage_widget.pyw"

alert() {
  osascript -e "display alert \"Claude Usage\" message \"$1\"" >/dev/null 2>&1
  exit 1
}

[ -f "$SCRIPT" ] || alert "claude_usage_widget.pyw was not found. Keep Claude Usage.app in the same folder as the widget."

for PY in /Library/Frameworks/Python.framework/Versions/Current/bin/python3 \
          /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
  if [ -x "$PY" ] && "$PY" -c "import tkinter" >/dev/null 2>&1; then
    exec "$PY" "$SCRIPT"
  fi
done
alert "Python 3 with Tkinter was not found. Install Python from python.org (or: brew install python-tk)."
